# Copy to .env for running on your own computer. GitHub Actions reads these
# from repository secrets and variables instead.

# Presenter username: the part after pollev.com/
POLLEV_USER=

# Class schedule, used when you run without --minutes
TIMEZONE=America/Los_Angeles
CLASS_DAYS=mon,wed,fri
CLASS_START=13:30
CLASS_END=14:20
# Optional: dates with no class
SKIP_DATES=

# Push notifications through the ntfy app. Pick a long random topic name;
# anyone who knows it can read your alerts.
NTFY_TOPIC=

# Optional: PagerDuty Events API v2 integration key (PagerDuty calls your phone)
PAGERDUTY_ROUTING_KEY=

# Optional: email through Gmail SMTP with an app password
ALERT_EMAIL_TO=
SMTP_USER=
SMTP_PASSWORD=
